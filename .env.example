# Copy to .env and fill in. Never commit .env.

# --- Client (Vite exposes only VITE_* variables to the browser) ---
VITE_HEARTH_CONTRACT=
VITE_SERVER_URL=
# Google OAuth client id (Web application). The server reads the same value.
VITE_GOOGLE_CLIENT_ID=

# --- Game server ---
PORT=8787
# Real seconds per game hour (24 hours = one game day). 2.5s -> 1 game day per minute.
SECONDS_PER_GAME_HOUR=2.5
# world data source: synthetic | replay | open-meteo
WORLD_SOURCE=replay
WORLD_REPLAY_FILE=data/world/replay-kansas-heatwave.json
# hours between Open-Meteo refreshes (WORLD_SOURCE=open-meteo)
WORLD_REFRESH_HOURS=3

# --- Players ---
# Secret that derives each player's NEAR account. Keep it stable; `npm run setup:testnet` fills it in.
PLAYER_KEY_SECRET=
# Typed-email login: on while VITE_GOOGLE_CLIENT_ID is empty. Set 1 to keep it with Google, 0 to turn it off.
ALLOW_DEV_LOGIN=

# --- NPC brain (NEAR AI Cloud, OpenAI-compatible API) ---
# off = rule-based haggling only, no tokens spent; llm = NEAR AI Cloud (check with `npm run llm:check`)
NPC_BRAIN=off
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
# a model id from `npm run llm:check`, e.g. zai-org/GLM-5.1-FP8
NEAR_AI_MODEL=
NEAR_AI_MAX_TOKENS=600
# minutes between two day plans for the same NPC (6 NPCs -> ~72 calls an hour at 5)
NPC_PLAN_MINUTES=5
# Fallback provider with the same OpenAI-style interface (optional)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# --- NEAR (testnet) ---
# chain adapter: mock | near
CHAIN=mock
NEAR_NETWORK=testnet
# one or more RPC endpoints, comma-separated; a rate-limited call moves on to the next
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs
# Your deployed contract account. NPCs become theo.<this>, mike.<this>, ...
HEARTH_CONTRACT=hearth.testnet
# Full-access key of HEARTH_CONTRACT, only needed by `npm run setup:testnet`. Remove it afterwards. Never commit.
OWNER_PRIVATE_KEY=
# Function-call access keys for NPC sub-accounts, one per NPC (ed25519:...).
# Filled in by `npm run setup:testnet`.
NPC_KEY_MIKE=
NPC_KEY_JACK=
NPC_KEY_BUBA=
NPC_KEY_CHLOE=
NPC_KEY_THEO=
NPC_KEY_BRUNO=
# Operator key (reconcile, world data, player relays, badges) on the contract account
ORACLE_ACCOUNT=
ORACLE_KEY=
# real seconds between two on-chain day starts, and a cap on transactions per minute
CHAIN_DAY_SECONDS=50
CHAIN_MAX_TX_PER_MINUTE=40
