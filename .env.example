# Copy to .env and fill in. Never commit .env.

# --- Client (Vite exposes only VITE_* variables to the browser) ---
VITE_HEARTH_CONTRACT=
VITE_SERVER_URL=

# --- Game server ---
PORT=8787
# Real seconds per game hour (24 hours = one game day). 2.5s -> 1 game day per minute.
SECONDS_PER_GAME_HOUR=2.5
# world data source: synthetic | replay | open-meteo
WORLD_SOURCE=replay
WORLD_REPLAY_FILE=data/world/replay-kansas-heatwave.json

# --- NPC brain (NEAR AI Cloud, OpenAI-compatible API) ---
# Verify base URL and model ids on https://docs.near.ai/ before use.
NEAR_AI_BASE_URL=
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
# Fallback provider with the same OpenAI-style interface (optional)
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
# off | llm  (off = rule-based haggling only, no tokens spent)
NPC_BRAIN=off

# --- NEAR (testnet) ---
# chain adapter: mock | near
CHAIN=mock
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Your deployed contract account. NPCs become theo.<this>, mike.<this>, ...
HEARTH_CONTRACT=hearth.testnet
# Full-access key of HEARTH_CONTRACT, only needed by `npm run setup:testnet`. Never commit.
OWNER_PRIVATE_KEY=
# Function-call access keys for NPC sub-accounts, one per NPC (ed25519:...).
# Filled in by `npm run setup:testnet`.
NPC_KEY_MIKE=
NPC_KEY_JACK=
NPC_KEY_BUBA=
NPC_KEY_CHLOE=
NPC_KEY_THEO=
NPC_KEY_BRUNO=
# Oracle key that may call post_world_data
ORACLE_ACCOUNT=oracle.hearth.testnet
ORACLE_KEY=
